{
  "schema_version": 3,
  "name": "book-translator",
  "repository": "https://github.com/tim8es/book-translator",
  "purpose": "Agent-native, resumable literary book translation with independent source-comparison review.",
  "primary_clients": [
    "ChatGPT Web",
    "Codex"
  ],
  "agent_agnostic": true,
  "skill_entrypoint": "SKILL.md",
  "contracts": {
    "global": "AGENTS.md",
    "setup": "docs/AGENT_SETUP.md",
    "orchestration": "docs/ORCHESTRATION.md",
    "translation": "docs/TRANSLATION.md"
  },
  "context_profiles": {
    "bootstrap": [
      "global",
      "setup"
    ],
    "orchestrator": [
      "global",
      "orchestration"
    ],
    "translator": [
      "global",
      "translation"
    ],
    "reviewer": [
      "global",
      "translation"
    ]
  },
  "version_policy": {
    "default_ref": "main",
    "rule": "Use the latest main when the user does not explicitly pin a tag, commit, or branch; resolve that ref once at setup and keep the resolved revision stable for the active book run.",
    "record_resolved_revision": true,
    "resolved_revision_file": ".book-translator-install.json",
    "per_book_provenance": "metadata.json.workflow",
    "silent_mid_run_upgrade": false
  },
  "required_user_inputs": [
    "source_book",
    "target_language"
  ],
  "optional_user_inputs": [
    "source_language",
    "title",
    "author",
    "output_format"
  ],
  "defaults": {
    "output_format": "markdown",
    "book_root": "books",
    "progress_file": "progress.json"
  },
  "bootstrap": {
    "preferred_method": "git_clone",
    "clone_url": "https://github.com/tim8es/book-translator.git",
    "mandatory_external_dependencies": [],
    "optional_runtime": "Python 3 standard library",
    "canonical_install_root": ".",
    "collision_install_root": ".book-translator"
  },
  "source_formats": {
    "automatic_helper": [
      "epub",
      "html",
      "xhtml",
      "markdown",
      "txt"
    ],
    "agent_dependent": [
      "docx",
      "pdf"
    ]
  },
  "chapter_states": [
    "pending",
    "extracted",
    "translated",
    "reviewed"
  ]
}
